{
  "opencollection": "1.0.0",
  "info": {
    "name": "Google Cloud Compute Engine Google Compute Engine Disks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
      "accessTokenUrl": "https://oauth2.googleapis.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Disks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Google Cloud Compute Engine List Disks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://compute.googleapis.com/compute/v1/projects/:project/zones/:zone/disks",
            "params": [
              {
                "name": "project",
                "value": "",
                "type": "path"
              },
              {
                "name": "zone",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a list of persistent disks contained within the specified zone."
        }
      ]
    }
  ],
  "bundled": true
}